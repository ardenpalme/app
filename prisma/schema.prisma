generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CreativeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContentType {
  CREATIVE
  DESIGN
  PLAYLIST
}


model Campaign {
  id                  String                @id @default(cuid())
  name               String
  startDate          DateTime
  endDate            DateTime
  status             CampaignStatus         @default(PENDING)
  notes              String?
  userId             String
  orgId              String
  creatives          Creative[]

  submittedBy        String?
  submissionDate     DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([orgId])
}

model Creative {
  id                 String                 @id @default(cuid())
  name               String
  notes              String?
  tags               String[]               @default([])
  approvalStatus     CreativeApprovalStatus @default(PENDING)
  proofOfPlay        Boolean                @default(false)
  orgId              String

  // R2 Storage Metadata
  // This is the unique key for the file in the R2 bucket, not a public URL.
  fileUrl            String
  fileType           String
  fileSize           Int

  // Media Metadata
  width              Int
  height             Int
  duration           Float

  submittedBy        String
  submissionDate     DateTime
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  playlist           Playlist?              @relation(fields: [playlistId], references: [id])
  playlistId         String?

  campaign           Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId         String?

  content            Content?               @relation("CreativeContent")

  @@index([orgId])
}

model rss_files {
  id                 String                 @id @default(cuid())
  name               String
  tags               String[]               @default([])
  url                String
  orgId              String
  createdAt          DateTime               @default(now())

  @@index([orgId])
}

model Design {
  id                 String                 @id @default(cuid())
  name               String
  tags               String[]               @default([])
  design_obj         Json
  orgId              String
  createdAt          DateTime               @default(now())

  content            Content?               @relation("DesignContent")

  @@index([orgId])
}

model Playlist {
  id                 String                 @id @default(cuid())
  name               String
  durationSec        Int
  assets             Creative[]
  assetOrder         String[]
  orgId              String
  createdAt          DateTime               @default(now())

  content            Content?               @relation("PlaylistContent")

  @@index([orgId])
}

model Content {
  id                 String                 @id @default(cuid())
  orgId              String
  type               ContentType

  creativeId         String?                @unique
  designId           String?                @unique
  playlistId         String?                @unique

  creative           Creative?              @relation("CreativeContent", fields: [creativeId], references: [id])
  design             Design?                @relation("DesignContent",   fields: [designId],   references: [id])
  playlist           Playlist?              @relation("PlaylistContent", fields: [playlistId], references: [id])

  schedules          Schedule[]

  @@index([orgId])
}


model Schedule {
  id                 String                 @id @default(cuid())
  start              DateTime
  end                DateTime

  // Will the content run forever with no time bounds?
  isInf              Boolean                

  // This content will run from start-time to end-time
  content            Content?               @relation(fields: [contentId], references: [id])
  contentId          String?

  displays           Display[]              @relation("ScheduleDisplays")

  orgId              String
  @@index([orgId])
}

model Display {
  id                 String                 @id @default(cuid())
  name               String
  tags               String[]

  schedules          Schedule[]             @relation("ScheduleDisplays")

  orgId              String
  @@index([orgId])
}
